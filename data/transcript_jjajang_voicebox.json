 "segments": [
  {
   "start": 0.15,
   "end": 1.49,
   "text": "1970년대 초"
  },
  {
   "start": 2.07,
   "end": 3.92,
   "text": "값을 올리면 안 되는 음식이 있었습니다."
  },
  {
   "start": 4.41,
   "end": 5.24,
   "text": "바로 짜장면이죠"
  },
  {
   "start": 5.75,
   "end": 8.95,
   "text": "정부가 짜장면 값을 100원 아래로 꽁꽁 묶어뒀거든요."
  },
  {
   "start": 9.69,
   "end": 10.45,
   "text": "그런데 이상하죠?"
  },
  {
   "start": 11.06,
   "end": 13.68,
   "text": "그때 물가는 해마다 10% 넘게 뛰었거든요."
  },
  {
   "start": 14.2,
   "end": 16.66,
   "text": "재료값은 오르는데 짜장면 값은 그대로"
  },
  {
   "start": 17.3,
   "end": 18.26,
   "text": "팔수록 손해였죠"
  },
  {
   "start": 18.87,
   "end": 20.53,
   "text": "그럼 값을 올리면 되지 않냐고요?"
  },
  {
   "start": 20.95,
   "end": 22.8,
   "text": "올리는 순간 위생 검사에"
  },
  {
   "start": 23.1,
   "end": 24.63,
   "text": "세무조사까지 들이닥쳤습니다."
  },
  {
   "start": 24.95,
   "end": 26.77,
   "text": "그래서 사장님들은 발상을 뒤집습니다."
  },
  {
   "start": 27.35,
   "end": 28.53,
   "text": "접 대신 이름을 바꾸자."
  },
  {
   "start": 29.02,
   "end": 30.13,
   "text": "해물을 넣은 삼선짜장"
  },
  {
   "start": 30.68,
   "end": 31.99,
   "text": "고기를 곱게 간 유닛 짜장"
  },
  {
   "start": 32.66,
   "end": 33.62,
   "text": "짜장면이 아니니까"
  },
  {
   "start": 33.98,
   "end": 34.77,
   "text": "값은 자유였죠."
  },
  {
   "start": 35.22,
   "end": 38.13,
   "text": "지금 메뉴판에 짜장이 이렇게 말라 해물을 넣은 삼선짜장"
  },
  {
   "start": 38.58,
   "end": 40.05,
   "text": "고기를 곱게 간 유닛 짜장"
  },
  {
   "start": 40.54,
   "end": 42.71,
   "text": "짜장면이 아니니까 값은 자유였죠"
  },
  {
   "start": 43.29,
   "end": 45.49,
   "text": "지금 메뉴판의 짜장이 이렇게 많은데에는"
  },
  {
   "start": 45.94,
   "end": 46.93,
   "text": "이런 사연이 있었던 겁니다."
  }
 ]
}