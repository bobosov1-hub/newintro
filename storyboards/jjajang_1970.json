 "captions": [
  {
   "start": 0.136,
   "end": 1.428,
   "text": "1970년대 초"
  },
  {
   "start": 1.428,
   "end": 3.509,
   "text": "값을 올리면 안 되는 음식"
  },
  {
   "start": 3.509,
   "end": 4.573,
   "text": "바로 **짜장면**이죠"
  },
  {
   "start": 4.573,
   "end": 5.61,
   "text": "정부가 짜장면 값을"
  },
  {
   "start": 5.61,
   "end": 7.791,
   "text": "**100원** 아래로 꽁꽁 묶어 뒀거든요"
  },
  {
   "start": 7.791,
   "end": 8.756,
   "text": "그런데 이상하죠?"
  },
  {
   "start": 8.756,
   "end": 11.336,
   "text": "그때 물가는 해마다 **10% 넘게** 뛰었거든요"
  },
  {
   "start": 11.336,
   "end": 13.664,
   "text": "재료값은 오르는데 짜장면 값은 그대로"
  },
  {
   "start": 13.664,
   "end": 14.918,
   "text": "팔수록 **손해**였죠"
  },
  {
   "start": 14.918,
   "end": 16.736,
   "text": "그럼 값을 올리면 되지 않냐고요?"
  },
  {
   "start": 16.736,
   "end": 17.77,
   "text": "올리는 순간"
  },
  {
   "start": 17.77,
   "end": 20.282,
   "text": "**위생 검사**에 **세무 조사**까지"
  },
  {
   "start": 20.282,
   "end": 22.179,
   "text": "그래서 사장님들은 발상을 뒤집습니다"
  },
  {
   "start": 22.179,
   "end": 23.482,
   "text": "값 대신 **이름**을 바꾸자"
  },
  {
   "start": 23.482,
   "end": 24.636,
   "text": "해물을 넣은 **삼선짜장**"
  },
  {
   "start": 24.636,
   "end": 26.155,
   "text": "고기를 곱게 간 **유니짜장**"
  },
  {
   "start": 26.155,
   "end": 27.199,
   "text": "짜장면이 아니니까"
  },
  {
   "start": 27.199,
   "end": 28.218,
   "text": "값은 **자유**였죠"
  },
  {
   "start": 28.218,
   "end": 30.233,
   "text": "지금 메뉴판에 짜장이 이렇게 많은 데에는"
  },
  {
   "start": 30.233,
   "end": 31.9,
   "text": "**이런 사연**이 있었던 겁니다"
  }
 ],
