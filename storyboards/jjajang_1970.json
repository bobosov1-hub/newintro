 "captions": [
  {
   "start": 0.4,
   "end": 1.869,
   "text": "1970년대 초"
  },
  {
   "start": 1.869,
   "end": 4.319,
   "text": "값을 올리면 안 되는 음식"
  },
  {
   "start": 4.319,
   "end": 5.669,
   "text": "바로 **짜장면**이죠"
  },
  {
   "start": 5.669,
   "end": 6.761,
   "text": "정부가 짜장면 값을"
  },
  {
   "start": 6.761,
   "end": 9.159,
   "text": "**100원** 아래로 꽁꽁 묶어 뒀거든요"
  },
  {
   "start": 9.159,
   "end": 10.324,
   "text": "그런데 이상하죠?"
  },
  {
   "start": 10.324,
   "end": 13.503,
   "text": "그때 물가는 해마다 **10% 넘게** 뛰었거든요"
  },
  {
   "start": 13.503,
   "end": 15.983,
   "text": "재료값은 오르는데 짜장면 값은 그대로"
  },
  {
   "start": 15.983,
   "end": 17.419,
   "text": "팔수록 **손해**였죠"
  },
  {
   "start": 17.419,
   "end": 19.626,
   "text": "그럼 값을 올리면 되지 않냐고요?"
  },
  {
   "start": 19.626,
   "end": 20.74,
   "text": "올리는 순간"
  },
  {
   "start": 20.74,
   "end": 23.541,
   "text": "**위생 검사**에 **세무 조사**까지"
  },
  {
   "start": 23.541,
   "end": 26.006,
   "text": "그래서 사장님들은 발상을 뒤집습니다"
  },
  {
   "start": 26.006,
   "end": 27.743,
   "text": "값 대신 **이름**을 바꾸자"
  },
  {
   "start": 27.743,
   "end": 29.095,
   "text": "해물을 넣은 **삼선짜장**"
  },
  {
   "start": 29.095,
   "end": 30.947,
   "text": "고기를 곱게 간 **유니짜장**"
  },
  {
   "start": 30.947,
   "end": 32.17,
   "text": "짜장면이 아니니까"
  },
  {
   "start": 32.17,
   "end": 33.437,
   "text": "값은 **자유**였죠"
  },
  {
   "start": 33.437,
   "end": 35.951,
   "text": "지금 메뉴판에 짜장이 이렇게 많은 데에는"
  },
  {
   "start": 35.951,
   "end": 38.427,
   "text": "**이런 사연**이 있었던 겁니다"
  }
 ],
